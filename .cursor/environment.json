{
  "name": "Pinbound",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "next-dev",
      "command": "bash -lc 'export PATH=\"$HOME/.bun/bin:$PATH\" && bun run dev'",
      "description": "Next.js dev server (Turbopack) on http://localhost:3000"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
